#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd;
    char buf[50];

    fd=open("file.txt",O_CREAT|O_RDWR,0644);
    write(fd,"Hello World",11);

    lseek(fd,0,SEEK_SET);
    read(fd,buf,11);
    buf[11]='\0';

    printf("Data: %s\n",buf);

    close(fd);
    return 0;
}
