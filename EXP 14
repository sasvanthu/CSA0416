#include <stdio.h>
#include <string.h>

int main()
{
    char file[10][20], name[20];
    int n=0, i;

    printf("Enter number of files: ");
    scanf("%d",&n);

    for(i=0;i<n;i++)
        scanf("%s",file[i]);

    printf("Files:\n");
    for(i=0;i<n;i++)
        printf("%s\n",file[i]);

    printf("Search file: ");
    scanf("%s",name);

    for(i=0;i<n;i++)
        if(strcmp(file[i],name)==0) {
            printf("File found");
            return 0;
        }

    printf("File not found");
}
