#include <stdio.h>
#include <pthread.h>

void *thread_function(void *arg)
{
    printf("Thread is executing...\n");
    return NULL;
}

int main()
{
    pthread_t tid;

    pthread_create(&tid, NULL, thread_function, NULL);

    pthread_join(tid, NULL);

    printf("Thread execution completed.\n");

    return 0;
}
OUTPUT
Thread is executing...
Thread execution completed.
