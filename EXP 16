#include <stdio.h>

struct emp {
    int id;
    char name[20];
    float salary;
};

int main()
{
    FILE *fp;
    struct emp e;
    int n,pos;

    fp=fopen("emp.dat","w+");

    printf("Enter number of employees: ");
    scanf("%d",&n);

    for(int i=0;i<n;i++) {
        scanf("%d %s %f",&e.id,e.name,&e.salary);
        fwrite(&e,sizeof(e),1,fp);
    }

    printf("Enter employee position: ");
    scanf("%d",&pos);

    fseek(fp,(pos-1)*sizeof(e),SEEK_SET);
    fread(&e,sizeof(e),1,fp);

    printf("%d %s %.2f",e.id,e.name,e.salary);

    fclose(fp);
    return 0;
}
